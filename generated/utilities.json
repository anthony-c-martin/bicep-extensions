  "samples": [
    {
      "title": "Pause a deployment",
      "description": "Waits for a fixed duration before continuing.",
      "url": "https://github.com/anthony-c-martin/bicep-ext-utilities/blob/main/samples/wait/main.bicep",
      "content": "targetScope = 'local'\n\nextension utilities\n\nresource wait 'Wait' = {\n  durationMs: 10000\n}"
    },
    {
      "title": "Run a command",
      "description": "Runs a single command and captures its output.",
      "url": "https://github.com/anthony-c-martin/bicep-ext-utilities/blob/main/samples/command/main.bicep",
      "content": "targetScope = 'local'\n\nextension utilities\n\nresource sayHello 'Command' = {\n  command: 'gh auth status'\n}\n\noutput stdout string? = sayHello.stdOut"
    },
    {
      "title": "Run a script",
      "description": "Runs the same script with Bash and with PowerShell.",
      "url": "https://github.com/anthony-c-martin/bicep-ext-utilities/blob/main/samples/script/main.bicep",
      "content": "targetScope = 'local'\n\nextension utilities\n\nparam name string\nparam platform 'Bash' | 'PowerShell'\n\nresource sayHelloWithBash 'Script' = if (platform == 'Bash') {\n  type: 'Bash'\n  script: replace(loadTextContent('./script.sh'), '$INPUT_NAME', name)\n}\n\nresource sayHelloWithPowerShell 'Script' = if (platform == 'PowerShell') {\n  type: 'PowerShell'\n  script: replace(loadTextContent('./script.ps1'), '$INPUT_NAME', name)\n}\n\noutput stdout string? = (platform == 'Bash') ? sayHelloWithBash.?stdOut : sayHelloWithPowerShell.?stdOut"
    },
    {
      "title": "Assert a condition",
      "description": "Fails the deployment when a condition is not met.",
      "url": "https://github.com/anthony-c-martin/bicep-ext-utilities/blob/main/samples/assert/main.bicep",
      "content": "targetScope = 'local'\n\nextension utilities\n\nresource assert 'Assert' = {\n  name: 'This should fail!'\n  condition: false\n}"
    }
  ]
